# Copy to .env and adjust as needed. .env is git-ignored - never commit real credentials.

# --- Teradata target ---
TD_HOST=192.168.1.205
TD_USER=dbc
TD_PASSWORD=dbc

# --- Per-job TPT service accounts (see teradata/ddl/08_tpt_users.bteq) ---
# Every tpt_demo_* user (one per TPT job, e.g. tpt_demo_a_customer) shares this
# one password - separate identities exist for per-job attribution and scoping
# each job to just its own demo database, not for per-job secrets.
TPT_JOB_PASSWORD=TptDemo2026Pass

# --- Kafka (internal, container-to-container) ---
KAFKA_BOOTSTRAP=kafka:19092

# --- Load generator pacing ---
LOAD_GEN_STEADY_RATE=2
LOAD_GEN_BURST_RATE=100
LOAD_GEN_BURST_SECONDS=20

# --- CSV load generator pacing (Scenario D) ---
CSV_LOAD_GEN_STEADY_RATE=2
CSV_LOAD_GEN_BURST_RATE=60
CSV_LOAD_GEN_BURST_SECONDS=20
