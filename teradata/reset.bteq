.LOGON ${TD_HOST}/${TD_USER},${TD_PASSWORD};
.SET ERROROUT STDOUT

/* Clean-slate reset for rehearsal: truncate every landing/target/admin table.
   Does NOT drop/recreate objects - run the DDL scripts separately if schema
   changes are needed. Kafka consumer group offsets are untouched; re-register
   the Debezium connector or reset consumer groups separately if a full replay
   from the beginning is desired. */

DELETE FROM DEMO_A.CUSTOMER_LANDING ALL;
DELETE FROM DEMO_A.ACCOUNT_LANDING ALL;
DELETE FROM DEMO_A.CARD_LANDING ALL;
DELETE FROM DEMO_A.PAYMENT_LANDING ALL;
DELETE FROM DEMO_A.TRANSACTION_LANDING ALL;
DELETE FROM DEMO_A.CUSTOMER ALL;
DELETE FROM DEMO_A."ACCOUNT" ALL;
DELETE FROM DEMO_A.CARD ALL;
DELETE FROM DEMO_A.PAYMENT ALL;
DELETE FROM DEMO_A."TRANSACTION" ALL;

DELETE FROM DEMO_B.CDC_LANDING ALL;
DELETE FROM DEMO_B.CUSTOMER ALL;
DELETE FROM DEMO_B."ACCOUNT" ALL;
DELETE FROM DEMO_B.CARD ALL;
DELETE FROM DEMO_B.PAYMENT ALL;
DELETE FROM DEMO_B."TRANSACTION" ALL;

DELETE FROM DEMO_C.TRANSACTION_LANDING ALL;
DELETE FROM DEMO_C.WARM_LANDING ALL;
DELETE FROM DEMO_C.CUSTOMER ALL;
DELETE FROM DEMO_C."ACCOUNT" ALL;
DELETE FROM DEMO_C.CARD ALL;
DELETE FROM DEMO_C.PAYMENT ALL;
DELETE FROM DEMO_C."TRANSACTION" ALL;

DELETE FROM DEMO_D.MERCHANT ALL;
DELETE FROM DEMO_D.BRANCH ALL;
DELETE FROM DEMO_D.FX_RATE ALL;

DELETE FROM DEMO_ADMIN.CDC_BATCH_CONTROL ALL;
DELETE FROM DEMO_ADMIN.APPLIED_EVENT_LOG ALL;

.LOGOFF;
.QUIT;
