.LOGON ${TD_HOST}/${TD_USER},${TD_PASSWORD};
.SET ERROROUT STDOUT
.SET ERRORLEVEL 5612 SEVERITY 0   /* "already exists" - USER and DATABASE share the DBC.Dbase namespace, tolerate re-running */

/* Per-TPT-job service accounts. Previously every TPT job (all scenarios) logged
   on as the same admin user (${TD_USER}). Each job now gets its own Teradata
   user, scoped to just the one demo database it loads into, so job activity is
   individually attributable and none of them carry dbc-level access. Perm space
   is drawn from DEMO_ADMIN (PERM = 0 - these users own no tables of their own,
   they only DML into DEMO_A/B/C/D's tables via GRANTs below). */

CREATE USER TPT_DEMO_A_CUSTOMER FROM DEMO_ADMIN AS PERM = 0, PASSWORD = ${TPT_JOB_PASSWORD}, DEFAULT DATABASE = DEMO_A;
CREATE USER TPT_DEMO_A_ACCOUNT FROM DEMO_ADMIN AS PERM = 0, PASSWORD = ${TPT_JOB_PASSWORD}, DEFAULT DATABASE = DEMO_A;
CREATE USER TPT_DEMO_A_CARD FROM DEMO_ADMIN AS PERM = 0, PASSWORD = ${TPT_JOB_PASSWORD}, DEFAULT DATABASE = DEMO_A;
CREATE USER TPT_DEMO_A_PAYMENT FROM DEMO_ADMIN AS PERM = 0, PASSWORD = ${TPT_JOB_PASSWORD}, DEFAULT DATABASE = DEMO_A;
CREATE USER TPT_DEMO_A_TRANSACTION FROM DEMO_ADMIN AS PERM = 0, PASSWORD = ${TPT_JOB_PASSWORD}, DEFAULT DATABASE = DEMO_A;
CREATE USER TPT_DEMO_B_ALL FROM DEMO_ADMIN AS PERM = 0, PASSWORD = ${TPT_JOB_PASSWORD}, DEFAULT DATABASE = DEMO_B;
CREATE USER TPT_DEMO_C_TRANSACTION FROM DEMO_ADMIN AS PERM = 0, PASSWORD = ${TPT_JOB_PASSWORD}, DEFAULT DATABASE = DEMO_C;
CREATE USER TPT_DEMO_C_WARM FROM DEMO_ADMIN AS PERM = 0, PASSWORD = ${TPT_JOB_PASSWORD}, DEFAULT DATABASE = DEMO_C;
CREATE USER TPT_DEMO_D_ALL FROM DEMO_ADMIN AS PERM = 0, PASSWORD = ${TPT_JOB_PASSWORD}, DEFAULT DATABASE = DEMO_D;

/* SELECT/INSERT/UPDATE/DELETE for the landing+target (or, for Scenario D,
   direct-upsert) DML each job's APPLY step runs, plus CREATE TABLE/DROP TABLE
   because TPT's STREAM operator auto-creates its own LogTable/ErrorTable pair
   on first run of a job name, plus CREATE MACRO/DROP MACRO/EXECUTE because the
   STREAM operator (TPump-derived) packs each APPLY statement's DML into a
   macro it creates, executes, and drops within its own session on every run -
   confirmed empirically (RDBMS error 3523 "does not have EXECUTE access" to
   the auto-generated macro without this grant; CREATE MACRO alone is not
   sufficient - EXECUTE is a distinct privilege even for a macro the same user
   just created). Scoped to each user's own demo database only - never DBC,
   never a sibling scenario's database. */

GRANT SELECT, INSERT, UPDATE, DELETE, CREATE TABLE, DROP TABLE, CREATE MACRO, DROP MACRO, EXECUTE ON DEMO_A TO TPT_DEMO_A_CUSTOMER;
GRANT SELECT, INSERT, UPDATE, DELETE, CREATE TABLE, DROP TABLE, CREATE MACRO, DROP MACRO, EXECUTE ON DEMO_A TO TPT_DEMO_A_ACCOUNT;
GRANT SELECT, INSERT, UPDATE, DELETE, CREATE TABLE, DROP TABLE, CREATE MACRO, DROP MACRO, EXECUTE ON DEMO_A TO TPT_DEMO_A_CARD;
GRANT SELECT, INSERT, UPDATE, DELETE, CREATE TABLE, DROP TABLE, CREATE MACRO, DROP MACRO, EXECUTE ON DEMO_A TO TPT_DEMO_A_PAYMENT;
GRANT SELECT, INSERT, UPDATE, DELETE, CREATE TABLE, DROP TABLE, CREATE MACRO, DROP MACRO, EXECUTE ON DEMO_A TO TPT_DEMO_A_TRANSACTION;
GRANT SELECT, INSERT, UPDATE, DELETE, CREATE TABLE, DROP TABLE, CREATE MACRO, DROP MACRO, EXECUTE ON DEMO_B TO TPT_DEMO_B_ALL;
GRANT SELECT, INSERT, UPDATE, DELETE, CREATE TABLE, DROP TABLE, CREATE MACRO, DROP MACRO, EXECUTE ON DEMO_C TO TPT_DEMO_C_TRANSACTION;
GRANT SELECT, INSERT, UPDATE, DELETE, CREATE TABLE, DROP TABLE, CREATE MACRO, DROP MACRO, EXECUTE ON DEMO_C TO TPT_DEMO_C_WARM;
GRANT SELECT, INSERT, UPDATE, DELETE, CREATE TABLE, DROP TABLE, CREATE MACRO, DROP MACRO, EXECUTE ON DEMO_D TO TPT_DEMO_D_ALL;

.LOGOFF;
.QUIT;
