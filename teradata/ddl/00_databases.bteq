.LOGON ${TD_HOST}/${TD_USER},${TD_PASSWORD};
.SET ERROROUT STDOUT
.SET ERRORLEVEL 5612 SEVERITY 0   /* "database already exists" - tolerate re-running this script */

CREATE DATABASE DEMO_A FROM DBC AS PERM = 500e6;
CREATE DATABASE DEMO_B FROM DBC AS PERM = 500e6;
CREATE DATABASE DEMO_C FROM DBC AS PERM = 500e6;
CREATE DATABASE DEMO_ADMIN FROM DBC AS PERM = 200e6;

.LOGOFF;
.QUIT;
